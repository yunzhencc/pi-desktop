{
  "name": "pi-desktop",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "Pi Coding Agent 桌面端",
  "author": "wangxingkang <wang_xingkang@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/yunzhencc/pi-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunzhencc/pi-desktop.git"
  },
  "bugs": "https://github.com/yunzhencc/pi-desktop/issues",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "install-electron",
    "clean": "tsx ./scripts/clean.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@dnd-kit/react": "catalog:core",
    "@earendil-works/pi-agent-core": "catalog:core",
    "@earendil-works/pi-ai": "catalog:core",
    "@earendil-works/pi-coding-agent": "catalog:core",
    "@earendil-works/pi-telemetry": "catalog:core",
    "@earendil-works/pi-tui": "catalog:core",
    "@electron-toolkit/utils": "catalog:core",
    "@lobehub/icons": "catalog:core",
    "@pi-desktop/pi-sdk": "workspace:*",
    "@pi-desktop/shadcn-ui": "workspace:*",
    "@pi-desktop/utils": "workspace:*",
    "@rc-component/image": "catalog:core",
    "@tanstack/react-hotkeys": "catalog:core",
    "@tanstack/react-query": "catalog:core",
    "@tanstack/react-router": "catalog:core",
    "@web-kits/audio": "catalog:core",
    "better-sqlite3": "catalog:core",
    "cmdk": "catalog:core",
    "electron-updater": "catalog:core",
    "enum-plus": "catalog:core",
    "es-toolkit": "catalog:core",
    "hosted-git-info": "catalog:core",
    "jotai": "catalog:core",
    "js-yaml": "catalog:core",
    "lucide-react": "catalog:core",
    "mdast-util-from-markdown": "catalog:core",
    "mdast-util-gfm": "catalog:core",
    "micromark-extension-gfm": "catalog:core",
    "motion": "catalog:core",
    "next-themes": "catalog:core",
    "overlayscrollbars": "catalog:core",
    "overlayscrollbars-react": "catalog:core",
    "prosemirror-commands": "catalog:core",
    "prosemirror-history": "catalog:core",
    "prosemirror-keymap": "catalog:core",
    "prosemirror-model": "catalog:core",
    "prosemirror-schema-basic": "catalog:core",
    "prosemirror-state": "catalog:core",
    "prosemirror-view": "catalog:core",
    "react-intl": "catalog:core",
    "zod": "catalog:core",
    "zustand": "catalog:core"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@commitlint/cli": "catalog:lint",
    "@commitlint/config-conventional": "catalog:lint",
    "@commitlint/types": "catalog:lint",
    "@eslint-react/eslint-plugin": "catalog:lint",
    "@formatjs/unplugin": "catalog:vite",
    "@playwright/test": "catalog:test",
    "@tailwindcss/vite": "catalog:vite",
    "@tanstack/router-plugin": "catalog:vite",
    "@testing-library/jest-dom": "catalog:test",
    "@testing-library/react": "catalog:test",
    "@testing-library/user-event": "catalog:test",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:vite",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "@vitest/web-worker": "catalog:test",
    "code-inspector-plugin": "catalog:vite",
    "electron": "catalog:electron",
    "electron-builder": "catalog:electron",
    "electron-vite": "catalog:vite",
    "eslint": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "jsdom": "catalog:test",
    "lint-staged": "catalog:dev",
    "playwright": "catalog:test",
    "react": "catalog:core",
    "react-dom": "catalog:core",
    "react-grab": "catalog:dev",
    "react-scan": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "tsx": "catalog:dev",
    "typed-query-selector": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:vite",
    "vitest": "catalog:test"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx lint-staged",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "browserslist": [
    "defaults"
  ]
}
